{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/.neath-api-key" }]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://neath.clingword.com/*" }]
    }
  ]
}
